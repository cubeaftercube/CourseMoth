<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The domain layer. Deliberately a plain net10.0 library with NO MAUI reference,
    so that it can be built and tested without a platform target.

    See docs: Docs/Maps/SystemMap.md and Docs/OpenQuestions.md ("Modules and projects").
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CourseMoth.Core</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
