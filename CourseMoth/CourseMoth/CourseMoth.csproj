<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>CourseMoth</RootNamespace>
		<UseMaui>true</UseMaui>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Compiled bindings: a binding without a resolvable x:DataType scope is an
		     error here rather than a silent fallback to reflection (XC0022).
		     XC0025 is deliberately NOT promoted: the project has Source= /
		     RelativeSource bindings and adding it would turn those into errors. -->
		<WarningsAsErrors>XC0022</WarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- The domain layer. A plain net10.0 library with no MAUI reference, so the
		     dependency direction stays UI -> Core and never the reverse (SystemMap §2). -->
		<ProjectReference Include="..\CourseMoth.Core\CourseMoth.Core.csproj" />

		<!-- The storage layer: SQLite-backed implementations of Core's repository interfaces.
		     Also a plain net10.0 library with no MAUI reference, because the Windows server
		     reads the same database (ServerApiSpec §2, "Storage note"). The UI references it
		     only to hand it a database path and to register it; no page or ViewModel ever
		     names a type from it (SystemMap §5). -->
		<ProjectReference Include="..\CourseMoth.Data\CourseMoth.Data.csproj" />
	</ItemGroup>

</Project>
