<?xml version="1.0" encoding="utf-8" ?>
<pages:CourseMothPage
    x:Class="CourseMoth.Pages.DownloadsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:CourseMoth.Pages"
    xmlns:vm="clr-namespace:CourseMoth.ViewModels"
    x:DataType="vm:DownloadsViewModel"
    Title="Downloads">

    <ContentPage.Content>
        <!-- A placeholder that says so. Downloads are stage 7 (UXMap §3.8); the empty view
             explains the stage rather than showing a queue that does not exist. -->
        <VerticalStackLayout
            Padding="32"
            Spacing="12"
            VerticalOptions="Center">
            <Label
                FontAttributes="Bold"
                FontSize="20"
                HorizontalTextAlignment="Center"
                Text="{Binding EmptyTitle}" />
            <Label
                HorizontalTextAlignment="Center"
                Opacity="0.75"
                Text="{Binding EmptyMessage}" />
            <Label
                FontSize="12"
                HorizontalTextAlignment="Center"
                Opacity="0.5"
                Text="{Binding StageNote}" />
        </VerticalStackLayout>
    </ContentPage.Content>
</pages:CourseMothPage>
